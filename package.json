{
  "name": "@faxforagents/botpress-integration",
  "version": "0.1.1",
  "private": true,
  "description": "Fax for Agents actions for Botpress.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faxforagents/botpress-integration.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "bp build",
    "check:type": "tsc --noEmit",
    "check:bplint": "bp lint",
    "test": "vitest run",
    "generate:schemas": "node scripts/generate-schemas.mjs",
    "build:example": "npm run build --prefix examples/fax-approval-bot",
    "check:example": "tsc --noEmit -p examples/fax-approval-bot/tsconfig.json"
  },
  "dependencies": {
    "@botpress/sdk": "7.2.11",
    "faxforagents": "0.2.5"
  },
  "devDependencies": {
    "@botpress/cli": "7.1.12",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
